    "            _ = self.model(to_backbone_input(u8[i:i + batch]))\n",
    "            for n in BLOCKS:\n",
    "                outs[n].append(self._buf[n].float().cpu().numpy())\n",
    "        return {n: np.concatenate(v) for n, v in outs.items()}\n",
