    "            \"transform\": transform or \"ooc\", \"severity\": severity,\n",
    "            \"schedule\": s, \"changepoints\": cps, \"on_segments\": segs,\n",
    "            \"n_windows\": len(s), \"cp\": cfg.cp_window}\n",
    "    return imgs, meta\n",
